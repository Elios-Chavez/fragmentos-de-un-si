---
import BaseLayout from '../layouts/BaseLayout.astro';
import portada from '../img/Portada.png';
import { bookMeta, chapters, dedication } from '../data/book-content';

const pdfUrl = '/fragmentos-de-un-si-primeros-8-capitulos.pdf';

const contentPages = [
  {
    id: 'dedicatoria',
    eyebrow: 'Antes de empezar',
    title: bookMeta.dedicationTitle,
    paragraphs: dedication,
  },
  ...chapters.map((chapter) => ({
    id: `capitulo-${chapter.number}`,
    eyebrow: `Capítulo ${chapter.number}`,
    title: chapter.title,
    paragraphs: chapter.paragraphs,
  })),
];

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

const formatText = (value: string) =>
  escapeHtml(value).replace(/\*([^*]+)\*/g, '<em>$1</em>');
---

<BaseLayout
  title={`${bookMeta.title} | Libro digital`}
  description="Libro digital Fragmentos de un Si en formato de libro abierto con portada y lectura en dos columnas."
>
  <main class="book-app">
    <header class="book-header">
      <div class="book-title-wrap">
        <p class="eyebrow">Primeros 8 capítulos · Valery Santos</p>
        <h1>Fragmentos de un <em>"Sí"</em></h1>
      </div>
      <a class="button" href={pdfUrl} target="_blank" rel="noreferrer">Descargar PDF</a>
    </header>

    <div class="book-stage" data-book>
      <button class="nav-btn prev" type="button" data-prev aria-label="Página anterior" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <div class="spreads-wrap">
        <!-- ── Portada ── -->
        <div class="spread cover-spread is-visible" data-spread="0">
          <div class="open-book cover-book">
            <div class="cover-left-page">
              <div class="cover-text-block">
                <div class="cover-ornament-top" aria-hidden="true">
                  <svg width="120" height="20" viewBox="0 0 120 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <line x1="0" y1="10" x2="48" y2="10" stroke="#bd766e" stroke-width="0.8" stroke-opacity="0.5"/>
                    <circle cx="60" cy="10" r="3.5" fill="#bd766e" fill-opacity="0.55"/>
                    <line x1="72" y1="10" x2="120" y2="10" stroke="#bd766e" stroke-width="0.8" stroke-opacity="0.5"/>
                  </svg>
                </div>
                <p class="cover-meta-label">Historia basada en hechos reales</p>
                <h2 class="cover-title-big">Fragmentos<br/>de un <em>"Sí"</em></h2>
                <p class="cover-author-label">Valery Santos</p>
                <div class="cover-ornament-bottom" aria-hidden="true">
                  <svg width="120" height="20" viewBox="0 0 120 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <line x1="0" y1="10" x2="48" y2="10" stroke="#bd766e" stroke-width="0.8" stroke-opacity="0.5"/>
                    <circle cx="60" cy="10" r="3.5" fill="#bd766e" fill-opacity="0.55"/>
                    <line x1="72" y1="10" x2="120" y2="10" stroke="#bd766e" stroke-width="0.8" stroke-opacity="0.5"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="cover-spine-line" aria-hidden="true"></div>
            <div class="cover-right-page">
              <img
                src={portada.src}
                width={portada.width}
                height={portada.height}
                alt="Portada de Fragmentos de un Sí"
                draggable="false"
              />
            </div>
          </div>
        </div>

        <!-- ── Páginas de contenido ── -->
        {contentPages.map((page, index) => (
          <div class="spread reading-spread" data-spread={String(index + 1)} id={page.id}>
            <div class="open-book reading-book">
              <div class="spine-overlay" aria-hidden="true"></div>
              <div class="page-shadow shadow-left" aria-hidden="true"></div>
              <div class="page-shadow shadow-right" aria-hidden="true"></div>
              <div class="page-content">
                <header class="page-header">
                  <p class="eyebrow">{page.eyebrow}</p>
                  <h2>{page.title}</h2>
                </header>
                <div class="prose">
                  {page.paragraphs.map((paragraph) => (
                    <p set:html={formatText(paragraph)} />
                  ))}
                </div>
                <div class="page-numbers" aria-hidden="true">
                  <span class="page-num">{(index + 1) * 2}</span>
                  <span class="page-num">{(index + 1) * 2 + 1}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <button class="nav-btn next" type="button" data-next aria-label="Página siguiente">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>

    <div class="page-indicator" aria-live="polite">
      <span data-current-label>Portada</span>
      <div class="dots" role="tablist" aria-label="Ir a página">
        <button class="dot is-active" data-dot="0" role="tab" aria-label="Portada" aria-selected="true"></button>
        {contentPages.map((page, index) => (
          <button class="dot" data-dot={String(index + 1)} role="tab" aria-label={page.title} aria-selected="false"></button>
        ))}
      </div>
    </div>
  </main>

  <script>
    const spreads      = Array.from(document.querySelectorAll<HTMLElement>('[data-spread]'));
    const dots         = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prevBtn      = document.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn      = document.querySelector<HTMLButtonElement>('[data-next]');
    const currentLabel = document.querySelector<HTMLElement>('[data-current-label]');

    let current   = 0;
    let animating = false;

    const labels = [
      'Portada',
      ...Array.from(
        document.querySelectorAll<HTMLElement>('[data-spread]:not([data-spread="0"]) h2')
      ).map(el => el.textContent?.trim() || 'Página'),
    ];

    function updateUI() {
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === current);
        dot.setAttribute('aria-selected', String(i === current));
      });
      if (currentLabel) currentLabel.textContent = labels[current] ?? 'Página';
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current === spreads.length - 1;
    }

    function goTo(next: number, dir: 'next' | 'prev') {
      if (animating || next === current || next < 0 || next >= spreads.length) return;
      animating = true;

      const outEl = spreads[current]!;
      const inEl  = spreads[next]!;

      outEl.style.transformOrigin = dir === 'next' ? 'left center' : 'right center';
      inEl.style.transformOrigin  = dir === 'next' ? 'right center' : 'left center';

      const outClass = dir === 'next' ? 'flip-out-next' : 'flip-out-prev';
      const inClass  = dir === 'next' ? 'flip-in-next'  : 'flip-in-prev';

      outEl.classList.add(outClass);

      setTimeout(() => {
        outEl.classList.remove('is-visible', outClass);
        outEl.style.transformOrigin = '';

        inEl.classList.add('is-visible');
        void inEl.offsetWidth; // force reflow so animation starts fresh
        inEl.classList.add(inClass);

        current = next;
        updateUI();
      }, 300);

      setTimeout(() => {
        inEl.classList.remove(inClass);
        inEl.style.transformOrigin = '';
        animating = false;
      }, 620);
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1, 'prev'));
    nextBtn?.addEventListener('click', () => goTo(current + 1, 'next'));

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => goTo(i, i > current ? 'next' : 'prev'));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft')  goTo(current - 1, 'prev');
      if (e.key === 'ArrowRight') goTo(current + 1, 'next');
    });

    updateUI();
  </script>
</BaseLayout>

<style>
  /* ─── Tokens ─── */
  :global(:root) {
    color-scheme: light;
    --paper:  #efe4d3;
    --page:   #fff8eb;
    --ink:    #2a2119;
    --muted:  #75675a;
    --line:   rgba(42, 33, 25, 0.13);
    --rose:   #bd766e;
    --night:  #201b18;
    --shadow: 0 36px 90px rgba(42, 33, 25, 0.30), -8px 0 24px rgba(42, 33, 25, 0.14);
  }

  :global(html) {
    background: var(--paper);
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    background:
      linear-gradient(90deg, rgba(130, 103, 74, 0.07) 1px, transparent 1px),
      linear-gradient(180deg, rgba(189, 118, 110, 0.09), transparent 38%),
      var(--paper);
    background-size: 80px 80px, auto, auto;
  }

  /* ─── App shell ─── */
  .book-app {
    width: min(1320px, calc(100% - clamp(16px, 4vw, 32px)));
    margin: 0 auto;
    padding: clamp(12px, 3vw, 24px) 0 clamp(28px, 5vw, 56px);
    display: grid;
    gap: clamp(12px, 3vw, 18px);
  }

  /* ─── Header ─── */
  .book-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(8px, 3vw, 16px);
    padding-bottom: clamp(8px, 2vw, 14px);
    border-bottom: 1px solid var(--line);
  }

  .book-title-wrap { display: grid; gap: clamp(3px, 1vw, 5px); }

  h1 {
    margin: 0;
    font-size: clamp(1.3rem, 5.5vw, 2.2rem);
    font-weight: 500;
    line-height: 1;
  }
  h1 em { color: var(--rose); font-style: italic; }

  h2 {
    margin: 0;
    font-size: clamp(1.1rem, 4vw, 2rem);
    line-height: 1;
    font-weight: 500;
  }

  p, figure { margin: 0; }

  .eyebrow {
    margin: 0;
    color: var(--rose);
    font: 700 0.7rem/1.25 Arial, sans-serif;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .button {
    min-height: clamp(32px, 8vw, 38px);
    display: inline-flex;
    align-items: center;
    padding: 0 clamp(10px, 3vw, 14px);
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--ink);
    background: rgba(255, 248, 235, 0.75);
    font: 700 clamp(0.7rem, 2vw, 0.8rem)/1 Arial, sans-serif;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 140ms ease;
  }
  .button:hover { transform: translateY(-1px); }

  /* ─── Book stage ─── */
  .book-stage {
    display: grid;
    grid-template-columns: clamp(28px, 6vw, 38px) minmax(0, 1fr) clamp(28px, 6vw, 38px);
    gap: clamp(4px, 2vw, 12px);
    align-items: center;
  }

  /* ─── Spreads container ─── */
  .spreads-wrap {
    position: relative;
    height: min(clamp(50vh, 70vh, 80vh), 840px);
    perspective: 1800px;
    perspective-origin: 50% 48%;
  }

  /* ─── Individual spread ─── */
  .spread {
    position: absolute;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
    border-radius: 3px 10px 10px 3px;
    box-shadow: var(--shadow);
    transform-origin: center center;
  }

  .spread.is-visible {
    visibility: visible;
    pointer-events: auto;
  }

  /* ─── Page-turn animations ─── */
  .flip-out-next { animation: flip-out-next 300ms cubic-bezier(0.4, 0, 0.8, 0.6) forwards; }
  .flip-in-next  { animation: flip-in-next  320ms cubic-bezier(0.2, 0.4, 0.6, 1.0) both; }
  .flip-out-prev { animation: flip-out-prev 300ms cubic-bezier(0.4, 0, 0.8, 0.6) forwards; }
  .flip-in-prev  { animation: flip-in-prev  320ms cubic-bezier(0.2, 0.4, 0.6, 1.0) both; }

  @keyframes flip-out-next {
    from { transform: perspective(1800px) rotateY(0deg);   opacity: 1;   }
    to   { transform: perspective(1800px) rotateY(-90deg); opacity: 0.15; }
  }
  @keyframes flip-in-next {
    from { transform: perspective(1800px) rotateY(90deg);  opacity: 0.15; }
    to   { transform: perspective(1800px) rotateY(0deg);   opacity: 1;   }
  }
  @keyframes flip-out-prev {
    from { transform: perspective(1800px) rotateY(0deg);   opacity: 1;   }
    to   { transform: perspective(1800px) rotateY(90deg);  opacity: 0.15; }
  }
  @keyframes flip-in-prev {
    from { transform: perspective(1800px) rotateY(-90deg); opacity: 0.15; }
    to   { transform: perspective(1800px) rotateY(0deg);   opacity: 1;   }
  }

  /* ─── Open book base ─── */
  .open-book {
    height: 100%;
    border-radius: 3px 10px 10px 3px;
    overflow: hidden;
  }

  /* ─── Cover spread ─── */
  .cover-book {
    display: grid;
    grid-template-columns: 1fr 3px 1fr;
    background: linear-gradient(160deg, #f7f0e6 0%, #ede4d2 100%);
  }

  .cover-left-page {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vw, 56px);
    background: linear-gradient(160deg, #f8f2e8 0%, #ede3d0 100%);
    box-shadow: inset -6px 0 20px rgba(42, 33, 25, 0.07);
  }

  .cover-text-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 3vw, 18px);
    text-align: center;
  }

  .cover-meta-label {
    margin: 0;
    color: var(--rose);
    font: italic clamp(0.8rem, 2.5vw, 0.95rem)/1.5 Georgia, serif;
    opacity: 0.9;
  }

  .cover-title-big {
    margin: 0;
    font-size: clamp(1.4rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--ink);
  }

  .cover-title-big em {
    color: var(--rose);
    font-style: italic;
  }

  .cover-author-label {
    margin: 0;
    color: var(--muted);
    font: 700 clamp(0.6rem, 2vw, 0.78rem)/1 Arial, sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cover-spine-line {
    background: linear-gradient(
      to right,
      rgba(42, 33, 25, 0.18) 0%,
      rgba(42, 33, 25, 0.06) 60%,
      transparent 100%
    );
  }

  .cover-right-page {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(14px, 2.5%, 28px);
    background: linear-gradient(160deg, #ede3d0 0%, #e6d9c4 100%);
    overflow: hidden;
  }

  .cover-right-page img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    display: block;
    border-radius: 4px;
    box-shadow: 0 20px 56px rgba(42, 33, 25, 0.32), 0 4px 12px rgba(42, 33, 25, 0.18);
    user-select: none;
  }

  /* ─── Reading spread ─── */
  .reading-book {
    position: relative;
    background: var(--page);
  }

  .spine-overlay {
    position: absolute;
    top: 0; bottom: 0;
    left: calc(50% - 2px);
    width: 5px;
    background: linear-gradient(
      to right,
      rgba(42, 33, 25, 0.22) 0%,
      rgba(42, 33, 25, 0.06) 60%,
      transparent 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  .page-shadow {
    position: absolute;
    top: 0; bottom: 0;
    width: 56px;
    z-index: 1;
    pointer-events: none;
  }

  .shadow-left {
    right: 50%;
    background: linear-gradient(to left, rgba(42, 33, 25, 0.11), transparent);
  }

  .shadow-right {
    left: 50%;
    background: linear-gradient(to right, rgba(42, 33, 25, 0.07), transparent);
  }

  /* ─── Page content (two-column) ─── */
  .page-content {
    height: 100%;
    box-sizing: border-box;
    padding: clamp(16px, 4vw, 52px) clamp(14px, 3vw, 56px) clamp(12px, 2vw, 36px);
    overflow-y: auto;
    position: relative;
  }

  .page-header {
    display: grid;
    gap: clamp(6px, 1.5vw, 10px);
    margin-bottom: clamp(14px, 3vw, 22px);
    padding-bottom: clamp(10px, 2vw, 16px);
    border-bottom: 1px solid var(--line);
  }

  .prose {
    column-count: 2;
    column-gap: clamp(16px, 4vw, 72px);
    column-rule: 1px solid rgba(42, 33, 25, 0.09);
  }

  .prose p {
    margin: 0 0 clamp(0.6rem, 1.2vw, 0.88rem);
    font-size: clamp(0.8rem, 2vw, 1.06rem);
    line-height: clamp(1.5, 1.7, 1.8);
    color: #312921;
    break-inside: avoid;
  }

  .prose em { color: var(--rose); font-style: italic; }

  .page-numbers {
    display: flex;
    justify-content: space-between;
    padding-top: clamp(8px, 2vw, 12px);
    margin-top: clamp(10px, 2vw, 16px);
    border-top: 1px solid var(--line);
  }

  .page-num {
    color: var(--muted);
    font: clamp(0.65rem, 1.5vw, 0.75rem)/1 Arial, sans-serif;
  }

  /* ─── Nav buttons ─── */
  .nav-btn {
    width: clamp(24px, 8vw, 36px);
    height: clamp(24px, 8vw, 36px);
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    background: rgba(255, 248, 235, 0.88);
    box-shadow: 0 6px 20px rgba(42, 33, 25, 0.13);
    cursor: pointer;
    transition: transform 140ms ease, opacity 140ms ease;
    align-self: center;
    flex-shrink: 0;
    padding: 0;
    font-size: clamp(12px, 3vw, 18px);
  }

  .nav-btn:hover { transform: scale(1.1); }
  .nav-btn:disabled { opacity: 0.28; cursor: default; transform: none; }

  /* ─── Page indicator ─── */
  .page-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 2vw, 14px);
    color: var(--muted);
    font: 700 clamp(0.65rem, 2vw, 0.78rem)/1 Arial, sans-serif;
    min-height: clamp(20px, 5vw, 24px);
    flex-wrap: wrap;
  }

  .dots {
    display: flex;
    gap: clamp(4px, 1vw, 6px);
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .dot {
    width: clamp(6px, 2vw, 8px);
    height: clamp(6px, 2vw, 8px);
    border: none;
    padding: 0;
    border-radius: 50%;
    background: rgba(42, 33, 25, 0.2);
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
    flex-shrink: 0;
  }

  .dot.is-active {
    background: var(--rose);
    transform: scale(1.25);
  }

  /* ─── Responsive ─── */
  @media (max-width: 820px) {
    .prose { column-count: 1; }
    .cover-book { grid-template-columns: 0.42fr 3px 1fr; }
  }

  @media (max-width: 640px) {
    .book-header { flex-direction: column; align-items: flex-start; gap: clamp(6px, 2vw, 12px); }
    .spreads-wrap { height: clamp(45vh, 65vh, 75vh); }
    .cover-left-page { display: none; }
    .cover-spine-line { display: none; }
    .cover-book { grid-template-columns: 1fr; }
  }

  @media (max-width: 400px) {
    .prose { font-size: clamp(0.75rem, 1.8vw, 0.9rem); }
    .page-indicator { gap: 6px; }
    .dots { gap: 3px; }
  }

  @media (max-width: 320px) {
    .book-app { padding: clamp(8px, 2vw, 12px) 0 clamp(16px, 3vw, 24px); }
    h1 { font-size: clamp(1rem, 5vw, 1.4rem); }
    h2 { font-size: clamp(0.95rem, 4vw, 1.2rem); }
    .page-content { padding: clamp(12px, 3vw, 16px) clamp(10px, 2.5vw, 14px) clamp(8px, 1.5vw, 12px); }
    .prose p { font-size: clamp(0.75rem, 1.8vw, 0.85rem); margin-bottom: clamp(0.5rem, 1vw, 0.65rem); }
    .eyebrow { font-size: clamp(0.5rem, 1.8vw, 0.6rem); }
  }

</style>
